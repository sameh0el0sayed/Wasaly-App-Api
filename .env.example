# Copy to .env and fill in. NEVER commit .env or real values. Values with special characters ($ ( ) # space)
# must be wrapped in single quotes:  KEY='value'   ($$ would otherwise be turned into a single $ by Docker Compose)

# ---- Environment ----
APP_ENV=development                  # production => migrations run on start; refuses demo seed and default secrets
PUBLIC_BASE_URL=https://api.example.com   # public HTTPS address of this API (Tap webhook/return URLs). Not localhost in production
CORS_ORIGINS=["https://app.example.com"]  # JSON list of allowed web origins (admin dashboard); ["*"] only for development
RUN_BACKGROUND_TASKS=true
ACCESS_TOKEN_MINUTES=720

# ---- Database ----
# Same password in both lines (docker-compose uses POSTGRES_PASSWORD for the db container)
POSTGRES_PASSWORD=change-me-db-password
DATABASE_URL=postgresql+asyncpg://transport:change-me-db-password@db:5432/transport

# ---- Secrets (generate your own; they must be unique per environment) ----
# python -c "import secrets;print(secrets.token_hex(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# ---- First super admin (created on first start only) ----
FIRST_ADMIN_NAME=Super Admin
FIRST_ADMIN_PHONE=
FIRST_ADMIN_PASSWORD=                # use single quotes if it has special characters
FIRST_ADMIN_MUST_CHANGE_PASSWORD=true

# ---- Files: Cloudinary (default; nothing is stored on the app server). "local" = dev only ----
# Cloudinary console -> Settings -> API Keys. NEVER commit them.
STORAGE_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=wasaly
UPLOAD_DIR=./storage                 # only used when STORAGE_BACKEND=local

# ---- Payments ----
TAP_SECRET_KEY=                      # sk_test_... / sk_live_... from the Tap dashboard
TAP_BASE_URL=https://api.tap.company/v2
# simulated = NO real money moves (testing) | none = admin transfers manually then marks it | http = your payout provider
PAYOUT_PROVIDER=none
PAYOUT_HTTP_URL=
PAYOUT_HTTP_TOKEN=

# ---- AI chatbot (Gemini key stays on the backend) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_THINKING_LEVEL=low
CHATBOT_RATE_LIMIT=10
AI_SERVICE_PHONE=
AI_SERVICE_PASSWORD=
# Internal API origin used by the AI reviewer to sign in and confirm matched records
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
AI_REVIEW_INTERVAL_SECONDS=600
AI_REVIEW_BATCH_SIZE=20
WHATSAPP_BUSINESS_NUMBER=973XXXXXXXX
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-long-random-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret

# ---- Push (FCM) ----
# Default file: secrets/firebase-service-account.json (git-ignored; docker-compose mounts ./secrets). Or set the path / the JSON itself:
FIREBASE_CREDENTIALS=secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_JSON=

# ---- Demo seed (DEVELOPMENT ONLY). Super admin = FIRST_ADMIN_* above. ----
SEED_DEMO_DATA=true
SEED_ADMIN_NAME=Demo Admin
SEED_ADMIN_PHONE=30000001
SEED_ADMIN_PASSWORD=admin@123123
SEED_AREA_NAME=Manama
SEED_AREA_POINTS=[[26.10,50.45],[26.10,50.70],[26.30,50.70],[26.30,50.45]]
SEED_CUSTOMER_NAME=Demo Customer
SEED_CUSTOMER_PHONE=33100001
SEED_CUSTOMER_CPR=900101001
SEED_CUSTOMER_PASSWORD=
SEED_DRIVER_NAME=Demo Driver
SEED_DRIVER_PHONE=33200001
SEED_DRIVER_CPR=850101002
SEED_DRIVER_PASSWORD=
SEED_DRIVER_LICENSE=LIC-DEMO-001
SEED_DRIVER_LICENSE_EXPIRY=2099-01-01
SEED_DRIVER_VEHICLE={"make":"Toyota","model":"Camry","year":2020,"color":"White","plate_number":"123456","passenger_capacity":4,"has_ac":true}
SEED_DRIVER_PAYOUT_IBAN=BH67BMAG00001299123456
SEED_DRIVER_GENDER=MALE
SEED_AIRPORT_NAME=Bahrain International Airport
SEED_AIRPORT_BOUNDARY={"type":"circle","center":[26.2708,50.6336],"radius_m":2500}
SEED_AIRPORT_FEE=0
