DATABASE_URL=postgresql+asyncpg://transport:transport@db:5432/transport
SECRET_KEY=change-me-to-a-long-random-string
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=
ACCESS_TOKEN_MINUTES=720
UPLOAD_DIR=./storage
FIRST_ADMIN_PHONE=+97300000000
FIRST_ADMIN_PASSWORD=ChangeMe!12345
FIRST_ADMIN_NAME=Super Admin
CORS_ORIGINS=["*"]
RUN_BACKGROUND_TASKS=true
PUBLIC_BASE_URL=https://api.example.com   # used for Tap webhook/return URLs
TAP_SECRET_KEY=                            # sk_test_... / sk_live_... from the Tap dashboard
TAP_BASE_URL=https://api.tap.company/v2
# simulated = NO real money moves (testing) | none = admin transfers manually then marks it | http = your payout provider
PAYOUT_PROVIDER=none
PAYOUT_HTTP_URL=
PAYOUT_HTTP_TOKEN=
# Push (FCM). Default file: secrets/firebase-service-account.json (git-ignored). Or set the path / the JSON itself:
FIREBASE_CREDENTIALS=secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_JSON=
# Files: Cloudinary (default; nothing is stored on the app server). "local" = dev only.
# Get the three values from the Cloudinary console -> Settings -> API Keys. NEVER commit them.
STORAGE_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=wasaly

# ---- Environment ----
APP_ENV=development                 # production => refuses demo seed and default secrets
FIRST_ADMIN_PHONE=
FIRST_ADMIN_PASSWORD=               # quote it if it has special characters:  FIRST_ADMIN_PASSWORD='...'
FIRST_ADMIN_MUST_CHANGE_PASSWORD=true

# ---- Demo seed (DEVELOPMENT ONLY). Super admin = FIRST_ADMIN_* above. ----
SEED_DEMO_DATA=true
SEED_ADMIN_NAME=Demo Admin
